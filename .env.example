# Copie este archivo como .env (en la misma carpeta) y complete solo lo que necesite.
# El archivo .env no se versiona ni entra en el ZIP de entrega. Nunca escriba la API key aquí.

# Modo del agente: reglas (por defecto, sin internet ni API key) o llm (IA generativa: Gemini o Claude).
AGENT_MODE=reglas

# Solo para AGENT_MODE=llm. Créela en https://console.anthropic.com y péguela en su .env, no aquí.
# Si falta, el agente usa el modo reglas y lo avisa.
ANTHROPIC_API_KEY=

# Proveedor de IA del modo llm: gemini (nivel gratuito de Google AI Studio) o anthropic (Claude API).
# Si solo hay GEMINI_API_KEY, se usa gemini automáticamente.
# LLM_PROVEEDOR=gemini

# Gemini gratis: cree la clave en https://aistudio.google.com/apikey y péguela en su .env, no aquí.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opcionales del modo llm con Claude.
ANTHROPIC_MODEL=claude-opus-5-5
SIE_LLM_ESFUERZO=low

# Opcionales: rutas de la base y de los logs (relativas a la raíz del proyecto).
# SIE_DB=datos/sie.db
# SIE_LOGS=logs
